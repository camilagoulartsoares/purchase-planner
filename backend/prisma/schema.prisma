generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                       @id @default(cuid())
  name                       String
  email                      String                       @unique
  passwordHash               String
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  products                   Product[]
  brands                     Brand[]
  mercadoLivreIntegration    MercadoLivreIntegration?
  mercadoLivreOauthStates    MercadoLivreOAuthState[]
  notifications              UserNotification[]
  findings                   Finding[]
  shopperConversations       ShopperConversation[]
  shopperCatalogProducts     ShopperCatalogProduct[]
  shopperCatalogQueries      ShopperCatalogQuery[]
  promotionSettings          PromotionSettings?
  promotionWatchItems        PromotionWatchItem[]
}

model PromotionSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingPostalCode String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PromotionWatchItem {
  id                String                  @id @default(cuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  searchTerm        String
  maximumTotalPrice Decimal
  active            Boolean                 @default(true)
  lastCheckedAt     DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  offers            PromotionOfferHistory[]
  alerts            PromotionAlertHistory[]

  @@index([userId, active])
}

model PromotionOfferHistory {
  id          String             @id @default(cuid())
  watchItemId String
  watchItem   PromotionWatchItem @relation(fields: [watchItemId], references: [id], onDelete: Cascade)
  store       String
  title       String
  productPrice Decimal
  shippingPrice Decimal?
  totalPrice  Decimal?
  originalPrice Decimal?
  discountPercentage Int?
  url         String
  imageUrl    String?
  seller      String?
  availability String?
  checkedAt   DateTime           @default(now())

  @@index([watchItemId, checkedAt])
  @@index([watchItemId, url])
}

model PromotionAlertHistory {
  id          String             @id @default(cuid())
  watchItemId String
  watchItem   PromotionWatchItem @relation(fields: [watchItemId], references: [id], onDelete: Cascade)
  store       String
  url         String
  totalPrice  Decimal
  sentAt      DateTime           @default(now())

  @@index([watchItemId, url, sentAt])
}

model ShopperConversation {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  context   Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  ShopperMessage[]
  searches  ShopperSearch[]

  @@index([userId, updatedAt])
}

model ShopperMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   ShopperConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  structuredData Json?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model ShopperSearch {
  id             String              @id @default(cuid())
  conversationId String
  conversation   ShopperConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  provider       String
  query          Json
  results        Json
  createdAt      DateTime            @default(now())
  expiresAt      DateTime?

  @@index([conversationId, createdAt])
}

model ShopperCatalogQuery {
  id             String                       @id @default(cuid())
  userId         String
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalQuery  String
  intentKey      String
  intent         Json
  discoveredAt   DateTime                     @default(now())
  mapExpiresAt   DateTime
  products       ShopperCatalogQueryProduct[]

  @@index([userId, intentKey])
  @@index([userId, mapExpiresAt])
}

model ShopperCatalogProduct {
  id                String                       @id @default(cuid())
  userId            String
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityKey       String
  title             String
  brand             String?
  line              String?
  composition       Json?
  measure           String?
  imageUrl          String?
  googleProductId   String?
  detailToken       String?
  attributes        Json?
  discoveredAt      DateTime                     @default(now())
  identityExpiresAt DateTime
  offers            ShopperCatalogOffer[]
  queries           ShopperCatalogQueryProduct[]

  @@unique([userId, identityKey])
  @@index([userId, identityExpiresAt])
}

model ShopperCatalogOffer {
  id               String                @id @default(cuid())
  catalogProductId String
  catalogProduct   ShopperCatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  store            String                @default("")
  merchant         String?
  price            Decimal?
  currency         String                @default("BRL")
  productUrl       String
  availability     String?
  source           String
  title            String
  payload          Json
  discoveredAt     DateTime              @default(now())
  priceCheckedAt   DateTime
  offerKey         String

  @@unique([catalogProductId, offerKey])
  @@index([priceCheckedAt])
}

model ShopperCatalogQueryProduct {
  queryId   String
  productId String
  query     ShopperCatalogQuery   @relation(fields: [queryId], references: [id], onDelete: Cascade)
  product   ShopperCatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([queryId, productId])
}

model Finding {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  brand         String?
  store         String?
  description   String?
  price         Decimal?
  previousPrice Decimal?
  currency      String        @default("BRL")
  originalUrl   String
  normalizedUrl String
  category      String?
  availability  String?
  provider      String?
  foundAt       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  media         FindingMedia[]

  @@unique([userId, normalizedUrl])
  @@index([userId, createdAt])
}

model FindingMedia {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  type      String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([findingId, position])
}

model Brand {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  logoUrl       String?
  logoPublicId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@unique([userId, name])
  @@unique([userId, slug])
  @@index([userId])
}

model Product {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId               String
  brand                 Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name                  String
  category              String
  store                 String
  originalPrice         Decimal
  promotionalPrice      Decimal?
  shippingPrice         Decimal?
  purchaseUrl           String?
  imageUrl              String?
  imagePublicId         String?
  color                 String?
  size                  String?
  priority              String               @default("Quero")
  status                String               @default("Quero comprar")
  notes                 String?
  isFavorite            Boolean              @default(false)
  purchasedPrice        Decimal?
  purchasedAt           DateTime?
  marketplace           String?
  externalItemId        String?
  externalData          Json?
  noLongerFavorited     Boolean              @default(false)
  importedAt            DateTime?
  lastMarketplaceSyncAt DateTime?
  targetPrice           Decimal?
  availability          String?
  purchaseIntent        String               @default("WANT")
  estimatedUses         Int?
  timesPostponed        Int                  @default(0)
  decisionStatus        String?
  lastAnalyzedAt        DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  images                ProductImage[]
  priceHistory          ProductPriceHistory[]
  notifications         UserNotification[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, category])
  @@index([brandId])
  @@index([userId, marketplace])
}

model ProductImage {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl      String
  imagePublicId String
  position      Int      @default(0)
  isMain        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([productId, position])
}

model MercadoLivreIntegration {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meliUserId            String
  nickname              String?
  siteId                String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenType             String    @default("Bearer")
  scopes                String
  tokenExpiresAt        DateTime
  lastRefreshedAt       DateTime?
  lastSyncedAt          DateTime?
  syncStatus            String    @default("idle")
  syncError             String?
  syncStartedAt         DateTime?
  autoSyncEnabled       Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model MercadoLivreOAuthState {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state      String   @unique
  redirectTo String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ProductPriceHistory {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  source              String
  previousPrice       Decimal?
  currentPrice        Decimal
  originalPrice       Decimal?
  lowestRecordedPrice Decimal?
  discountPercentage  Int?
  availability        String?
  checkedAt           DateTime @default(now())
  details             Json?

  @@index([productId, checkedAt])
}

model UserNotification {
  id           String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  type          String
  dedupeKey     String   @unique
  title         String
  body          String
  payload       Json?
  whatsappStatus String   @default("not_configured")
  whatsappAttempts Int    @default(0)
  whatsappLastError String?
  whatsappSentAt DateTime?
  readAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}
